# URL of your deployed backend API server (Railway/Render/Fly.io).
# Required in production — without it, API calls will hit this site's own
# domain instead of your backend, and everything will 404.
# Example: VITE_API_URL=https://your-app.up.railway.app
VITE_API_URL=

# Optional: override the Render streaming/download server.
VITE_STREAM_API_URL=https://app-decompiling.onrender.com
